{% extends 'base.html.j2' %}
{% from '_macros.html.j2' import arrow %}

{% block title %}{{ config.name }} — {{ config.site_subtitle or ('Circadian Rhythms & Sleep Genetics' if is_owner else config.designation) }}{% endblock %}

{% block content %}
  {# ── INTRO / ABOUT ────────────────────────────────────────────────── #}
  <section class="intro" id="about" aria-labelledby="intro-name">
    <div class="wrap intro__grid">
      <div class="intro__main">
        {%- if config.name_native %}
        <p class="intro__native bn" lang="bn">{{ config.name_native }}</p>
        {%- endif %}
        <h1 class="intro__name" id="intro-name">{{ config.name }}</h1>
        <p class="intro__role">
          <strong>{{ config.designation }}</strong> · {{ config.affiliation }} · {{ config.location }}
        </p>

        <div class="bio prose">
          {%- for paragraph in config.bio %}
          <p>{{ paragraph | safe }}</p>
          {%- endfor %}
        </div>

        <div class="intro__actions">
          <a class="btn btn--solid" href="mailto:{{ config.email }}">Email me</a>
          <a class="btn" href="{{ config.scholar_url }}" target="_blank" rel="noopener">Google Scholar {{ arrow() }}</a>
          <a class="btn" href="https://github.com/{{ config.github }}" target="_blank" rel="noopener">GitHub {{ arrow() }}</a>
          <a class="btn" href="cv.html">CV {{ arrow('right') }}</a>
        </div>
      </div>

      <aside class="intro__side" aria-label="Portrait and research themes">
        <figure class="portrait-card">
          <picture>
            <source srcset="assets/profile.webp" type="image/webp" />
            <img src="assets/profile-720.jpg" alt="Portrait of {{ config.name }}" width="720" height="720" decoding="async" />
          </picture>
        </figure>

        {%- if config.tags %}
        <div class="side-block">
          <h2 class="side-block__title">Research areas</h2>
          <ul class="tag-list">
            {%- for tag in config.tags %}
            <li>{{ tag }}</li>
            {%- endfor %}
          </ul>
        </div>
        {%- endif %}
      </aside>
    </div>
  </section>

  {# ── RESEARCH ─────────────────────────────────────────────────────── #}
  {%- set topics = (config.research or {}).get('topics') %}
  {% if show_chrono_figures or topics %}
  <section class="section" id="research" aria-labelledby="research-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h2" id="research-h">Research</h2>
        {%- if config.statement %}
        <p class="sec-lede">{{ config.statement | safe }}</p>
        {%- endif %}
      </div>

      {%- if show_chrono_figures %}
      {% set acto = config.research.actogram %}
      <div class="research__block">
        <div class="research__copy prose">
          <h3 class="h3">{{ acto.title }}</h3>
          {%- for p in acto.text %}
          <p>{{ p | safe }}</p>
          {%- endfor %}

          <div class="tau">
            <div class="tau__presets" role="group" aria-label="Classic Drosophila clock genotypes">
              <button class="chip is-active" type="button" data-genotype="wt" data-tau-val="23.8">Wild-type (23.8h)</button>
              <button class="chip" type="button" data-genotype="pers" data-tau-val="19.0"><em>per</em><sup>S</sup> (19h)</button>
              <button class="chip" type="button" data-genotype="perl" data-tau-val="29.0"><em>per</em><sup>L</sup> (29h)</button>
              <button class="chip" type="button" data-genotype="per0" data-tau-val="arrhythmic"><em>per</em><sup>0</sup> (arrhythmic)</button>
            </div>
            <div class="tau__row">
              <label class="tau__lbl" for="tau">Free-running period (τ)</label>
              <output for="tau" data-tau-out>23.8<small>h</small></output>
            </div>
            <input class="range" id="tau" type="range" min="18.5" max="29.5" step="0.1" value="23.8" data-tau />
            <div class="tau__scale" aria-hidden="true"><span>18.5h · fast clock</span><span>24h</span><span>slow clock · 29.5h</span></div>
          </div>
        </div>

        <figure class="fig">
          <div class="fig__bar">
            <span><strong>Fig. 1</strong> · Double-plotted <em>Drosophila</em> actogram</span>
            <span class="fig__tag">Simulated · Interactive</span>
          </div>
          <canvas data-actogram role="img" aria-label="Interactive double-plotted actogram of a fruit fly: seven days in light–dark cycles with morning and evening activity peaks, followed by seven days in constant darkness where peaks drift according to the endogenous period tau."></canvas>
          <figcaption class="fig__foot">
            <span data-acto-cap>7 days LD 12:12, then constant darkness (DD)</span>
            <span class="fig__hint">hover a day</span>
          </figcaption>
        </figure>
      </div>

      {% set hmm = config.research.sleep_states %}
      <div class="research__block">
        <div class="research__copy prose">
          <h3 class="h3">{{ hmm.title }}</h3>
          {%- for p in hmm.text %}
          <p>{{ p | safe }}</p>
          {%- endfor %}
          {%- if hmm.links %}
          <div class="research__links">
            {%- for l in hmm.links %}
            <a class="btn{% if loop.first %} btn--solid{% endif %}" href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }} {{ arrow() }}</a>
            {%- endfor %}
          </div>
          {%- endif %}
        </div>

        <figure class="fig">
          <div class="fig__bar">
            <span><strong>Fig. 2</strong> · Hidden Markov model · Generative simulation</span>
            <button class="fig__toggle" type="button" data-hmm-toggle aria-pressed="false">Pause</button>
          </div>
          <svg class="hmm__diagram" viewBox="0 0 520 142" aria-hidden="true" data-hmm-diagram>
            <defs>
              <marker id="hmm-ah" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path class="hmm__arrow" d="M0 0L8 4L0 8z" />
              </marker>
            </defs>
            {%- set xs = [65, 195, 325, 455] %}
            {%- for i in range(3) %}
            <path class="hmm__edge" data-edge="{{ i }}-{{ i + 1 }}" d="M{{ xs[i] + 22 }} 60Q{{ (xs[i] + xs[i + 1]) / 2 }} 30 {{ xs[i + 1] - 22 }} 60" marker-end="url(#hmm-ah)" />
            <path class="hmm__edge" data-edge="{{ i + 1 }}-{{ i }}" d="M{{ xs[i + 1] - 22 }} 84Q{{ (xs[i] + xs[i + 1]) / 2 }} 114 {{ xs[i] + 22 }} 84" marker-end="url(#hmm-ah)" />
            {%- endfor %}
            {%- for abbr, label in [('AW', 'active wake'), ('QW', 'quiet wake'), ('LS', 'light sleep'), ('DS', 'deep sleep')] %}
            <g class="hmm__node" data-node="{{ loop.index0 }}">
              <circle cx="{{ xs[loop.index0] }}" cy="72" r="20" />
              <text class="hmm__abbr" x="{{ xs[loop.index0] }}" y="77">{{ abbr }}</text>
              <text x="{{ xs[loop.index0] }}" y="136">{{ label }}</text>
            </g>
            {%- endfor %}
          </svg>
          <canvas data-hypnogram role="img" aria-label="Generative HMM simulation: activity counts above are emitted by the simulated hidden state sequence below. The state trace is not inferred from these counts."></canvas>
          <figcaption class="fig__foot">
            <span data-hmm-cap>Simulated state: <b>—</b></span>
            <span class="fig__hint">simulated counts ↑ · generating state ↓</span>
          </figcaption>
        </figure>
      </div>
      {% else %}
      {%- for t in topics %}
      <div class="research__copy prose"{% if not loop.first %} style="margin-top:28px"{% endif %}>
        {%- if t.title %}<h3 class="h3">{{ t.title }}</h3>{% endif %}
        {%- for p in t.text or [] %}<p>{{ p | safe }}</p>{% endfor %}
        {%- if t.links %}
        <div class="research__links">
          {%- for l in t.links %}
          <a class="btn{% if loop.first %} btn--solid{% endif %}" href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }} {{ arrow() }}</a>
          {%- endfor %}
        </div>
        {%- endif %}
      </div>
      {%- endfor %}
      {%- endif %}
    </div>
  </section>
  {% endif %}

  {# ── SELECTED PUBLICATIONS ────────────────────────────────────────── #}
  {% if selected_publications %}
  <section class="section" id="selected" aria-labelledby="sel-h">
    <div class="wrap">
      <div class="sec-head sec-head--row">
        <div>
          <h2 class="h2" id="sel-h">Selected publications</h2>
          <p class="sec-sub">{% if is_owner %}A sample across my postdoc, PhD, and MSc work ({{ pub_year_range }}).{% else %}Selected work ({{ pub_year_range }}).{% endif %}</p>
        </div>
        <a class="btn" href="publications.html">All {{ pub_count }} publications {{ arrow('right') }}</a>
      </div>

      <ol class="sel-pubs">
        {%- for pub in selected_publications %}
        <li class="sel-pub">
          <span class="sel-pub__year">{{ pub.year }}</span>
          <div class="sel-pub__body">
            <h3 class="sel-pub__title">
              {%- if pub.url %}
              <a href="{{ pub.url }}" target="_blank" rel="noopener">{{ pub.title }}</a>
              {%- else %}
              {{ pub.title }}
              {%- endif %}
            </h3>
            <p class="sel-pub__meta">{{ pub.authors_short | safe }} · <em>{{ pub.venue_short }}</em>{% if pub.note %} ({{ pub.note }}){% endif %}</p>
            {%- if pub.summary %}
            <p class="sel-pub__summary">{{ pub.summary }}</p>
            {%- endif %}
          </div>
        </li>
        {%- endfor %}
      </ol>
    </div>
  </section>
  {% endif %}

  {# ── NEWS ─────────────────────────────────────────────────────────── #}
  {% if news %}
  <section class="section" id="news" aria-labelledby="news-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h2" id="news-h">Recent updates</h2>
      </div>
      <ol class="news">
        {%- for item in news %}
        <li class="news__item">
          <time class="news__date" datetime="{{ item.date }}">{{ item.date_formatted }}</time>
          <p class="news__text prose">{{ item.description | safe }}</p>
        </li>
        {%- endfor %}
      </ol>
    </div>
  </section>
  {% endif %}
{% endblock %}

{% block scripts %}
  {%- if show_chrono_figures %}
  <script src="{{ root }}assets/js/research.js" defer></script>
  {%- endif %}
{% endblock %}
