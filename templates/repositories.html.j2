{% from 'base.html.j2' import topbar, statusbar %}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Research software and open-source repositories by {{ config.name }}, including tools for sleep, circadian rhythm, and time-series analysis." />
  <title>{{ config.name }} — Repositories</title>
  <link rel="stylesheet" href="terminal.css" />
  <link rel="icon" type="image/svg+xml" href="favicon.svg" />
</head>
<body>
  {{ topbar('repositories') }}

  <div class="page-body">
    <div class="page-title fade-in"><span class="prompt">$</span> gh repo list</div>
    <div class="page-subtitle fade-in fade-in-d1"><span class="comment">// open-source tools and research software</span></div>

    <div class="fade-in fade-in-d2">
      <div class="section-label">// github profile</div>
      <div style="font-size: 14px; line-height: 2; margin-bottom: 28px;">
        <span class="prompt">user</span><span class="muted">:</span> <a href="https://github.com/{{ config.github }}">{{ config.github }}</a><br />
        <span class="prompt">bio</span><span class="muted">:</span> {{ config.designation }} · NHLBI / NIH · Circadian rhythms &amp; sleep genetics
      </div>
    </div>

    <div class="fade-in fade-in-d3">
      <div class="section-label">// repositories</div>
      <div class="repo-grid">
        {% for repo in repositories %}
        <a href="{{ repo.url }}" class="repo-card" style="text-decoration:none;">
          <div class="repo-card__name">{{ repo.name }}</div>
          <div class="repo-card__desc">{{ repo.description | safe }}</div>
          <div class="repo-card__lang">
            {% for lang in repo.language_pills %}
            <span class="repo-card__lang-dot" style="background: {{ lang.color }};{% if not loop.first %} margin-left: 10px;{% endif %}"></span> {{ lang.name }}
            {% endfor %}
          </div>
          <div class="repo-card__link">view on github →</div>
        </a>
        {% endfor %}
      </div>
    </div>
  </div>

  {{ statusbar(
    (repositories | length) ~ ' repositories · github.com/' ~ config.github,
    '© ' ~ config.copyright_year ~ ' ' ~ config.name
  ) }}

  <script src="theme.js"></script>
  <script src="terminal-easteregg.js"></script>
</body>
</html>
