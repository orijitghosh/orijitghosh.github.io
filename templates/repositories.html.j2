{% extends 'base.html.j2' %}
{% from '_macros.html.j2' import arrow %}

{% block title %}Code — {{ config.name }}{% endblock %}
{% block description %}Open-source software and creative projects by {{ config.name }}: R packages for sleep and circadian biology, ggplot2 and Shiny tools, typeface design, and generative graphics.{% endblock %}

{% block content %}
  <header class="phead wrap">
    <h1 class="phead__title">Software &amp; code</h1>
    <p class="phead__lede">
      Open-source R packages and Shiny apps I’ve built for analyzing <em>Drosophila</em> sleep and circadian rhythms, general-purpose visualization and UI tools for <em>ggplot2</em> and Shiny, and side projects in typeface design and generative graphics. Find my profile and personal repositories on <a class="link" href="https://github.com/{{ config.github }}" target="_blank" rel="noopener">github.com/{{ config.github }}</a>.
    </p>
  </header>

  <section class="wrap repos-section" aria-label="Repositories">
    <ul class="repos">
      {%- for repo in repositories %}
      <li>
        <article class="repo">
          <div class="repo__head">
            <h2 class="repo__name">
              <a class="repo__link" href="{{ repo.url }}" target="_blank" rel="noopener">{{ repo.name }}</a>
            </h2>
            <span class="repo__ext" aria-hidden="true">{{ arrow(size=15) }}</span>
          </div>
          <p class="repo__desc prose">{{ repo.description | safe }}</p>
          {%- if repo.language_pills or repo.link_url %}
          <div class="repo__foot">
            {%- if repo.language_pills %}
            <ul class="repo__legend" aria-label="Languages">
              {%- for l in repo.language_pills %}
              <li style="--c:{{ l.color }}"><i></i>{{ l.name }}</li>
              {%- endfor %}
            </ul>
            {%- endif %}
            {%- if repo.link_url %}
            <a class="repo__sublink" href="{{ repo.link_url }}" target="_blank" rel="noopener">{{ repo.link_label or 'Website' }} {{ arrow(size=12) }}</a>
            {%- endif %}
          </div>
          {%- endif %}
        </article>
      </li>
      {%- endfor %}
    </ul>
  </section>
{% endblock %}
