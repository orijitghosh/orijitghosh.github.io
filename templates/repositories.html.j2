{% extends 'base.html.j2' %}
{% from '_macros.html.j2' import arrow %}

{% block title %}Code — {{ config.name }}{% endblock %}
{% block description %}Open-source software by {{ config.name }}: R packages and Shiny apps for circadian rhythm and sleep analysis.{% endblock %}

{% block content %}
  <header class="phead wrap">
    <p class="eyebrow" data-reveal="fade"><span class="idx">{{ repositories | length }}</span>Repositories</p>
    <h1 class="phead__title" data-words>Research <em>software</em><br />&amp; side projects.</h1>
    <div class="phead__row">
      <p class="phead__lede" data-reveal>R packages and Shiny apps for analyzing sleep and circadian data from <em>Drosophila</em>, plus side projects: hand-drawn plots for <em>ggplot2</em>, a bonsai grown from GitHub history, color palettes, and the code behind this site.</p>
      <div class="shell" data-shell data-reveal>
        <span class="shell__cmd"><span data-shell-type>gh repo list {{ config.github }}</span><span class="shell__caret" aria-hidden="true"></span></span>
        <span class="shell__out">→ {{ repositories | length }} repositories, all public</span>
      </div>
    </div>
  </header>

  <section class="wrap section" style="padding-top:0" aria-label="Repositories">
    <ul class="repos">
      {%- for repo in repositories %}
      <li data-reveal style="--d:{{ (loop.index0 % 2) * 90 }}">
        <a class="repo" href="{{ repo.url }}" target="_blank" rel="noopener" data-tilt data-inview data-cursor-label="Open">
          <span class="repo__glare" aria-hidden="true"></span>
          <span class="repo__top"><span>{{ '%02d' | format(loop.index) }} / {{ '%02d' | format(repositories | length) }}</span><span class="repo__star" aria-hidden="true">{{ arrow(size=16) }}</span></span>
          <span class="repo__name">{{ repo.name }}</span>
          <span class="repo__desc">{{ repo.description | safe }}</span>
          {%- if repo.language_pills %}
          <span class="repo__langs">
            <span class="repo__bar" aria-hidden="true">{% for l in repo.language_pills %}<span style="--c:{{ l.color }};--i:{{ loop.index0 }}"></span>{% endfor %}</span>
            <ul class="repo__legend" aria-label="Languages">{% for l in repo.language_pills %}<li style="--c:{{ l.color }}"><i></i>{{ l.name }}</li>{% endfor %}</ul>
          </span>
          {%- endif %}
        </a>
      </li>
      {%- endfor %}
    </ul>
  </section>
{% endblock %}
