{%- from '_macros.html.j2' import arrow, dial_mark -%}
{%- set nav_items = [
  ('index', 'index.html', 'About'),
  ('publications', 'publications.html', 'Publications'),
  ('repositories', 'repositories.html', 'Code'),
  ('cv', 'cv.html', 'CV'),
  ('teaching', 'teaching.html', 'Teaching'),
] -%}
{%- set city = config.location.split(',')[0] -%}
<!DOCTYPE html>
<html lang="en" data-theme="light" data-page="{{ active }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% block title %}{{ config.name }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{% if is_owner %}{{ config.name }}, {{ config.designation | lower }} at {{ config.affiliation }}, studying circadian rhythms and sleep genetics in Drosophila.{% else %}{{ config.name }} — {{ config.designation }} at {{ config.affiliation }}.{% endif %}{% endblock %}" />
  <meta name="author" content="{{ config.name }}" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#faf7f1" />
  <meta property="og:title" content="{{ self.title() }}" />
  <meta property="og:description" content="{{ self.description() }}" />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="{{ root }}favicon.svg" />
  {% block head_meta %}{% endblock %}
  <script>
    /* Set day/night theme before first paint based on saved choice or local hour */
    (function () {
      var d = document.documentElement, h = new Date().getHours(), t = null;
      try { t = localStorage.getItem('ag-theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') t = (h >= 6 && h < 18) ? 'light' : 'dark';
      d.setAttribute('data-theme', t);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..500&family=Instrument+Sans:ital,wght@0,400..600;1,400..600&family=JetBrains+Mono:wght@400..500&display=swap" />
  {%- if config.name_native %}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tiro+Bangla&display=swap&text={{ config.name_native | urlencode }}" />
  {%- endif %}
  <link rel="stylesheet" href="{{ root }}assets/css/site.css" />
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav" data-nav>
    <div class="wrap nav__inner">
      <a class="nav__brand" href="{{ root }}index.html">
        {{ dial_mark() }}
        <span class="nav__name">{{ config.name }}</span>
      </a>

      <nav class="nav__links" aria-label="Primary">
        {%- for key, href, label in nav_items %}
        <a class="nav__link" href="{{ root }}{{ href }}"{% if active == key %} aria-current="page"{% endif %}>{{ label }}</a>
        {%- endfor %}
      </nav>

      <div class="nav__tools">
        <span class="nav__clock" data-clock title="Your local time and Zeitgeber time (hours since 06:00 lights-on)">--:-- · <b>ZT --</b></span>
        <button class="ld" type="button" data-theme-toggle aria-label="Switch between light and dark theme" title="Toggle light / dark theme">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <defs>
              <mask id="ld-mask" maskUnits="userSpaceOnUse" x="-6" y="-6" width="36" height="36">
                <rect x="-6" y="-6" width="36" height="36" fill="#fff" />
                <circle class="ld__cut" cx="17" cy="7" r="5.6" fill="#000" />
              </mask>
            </defs>
            <circle class="ld__core" cx="12" cy="12" r="4.6" mask="url(#ld-mask)" />
            <g class="ld__rays">
              <line x1="12" y1="1.8" x2="12" y2="4.2" /><line x1="12" y1="19.8" x2="12" y2="22.2" />
              <line x1="1.8" y1="12" x2="4.2" y2="12" /><line x1="19.8" y1="12" x2="22.2" y2="12" />
              <line x1="4.8" y1="4.8" x2="6.5" y2="6.5" /><line x1="17.5" y1="17.5" x2="19.2" y2="19.2" />
              <line x1="4.8" y1="19.2" x2="6.5" y2="17.5" /><line x1="17.5" y1="6.5" x2="19.2" y2="4.8" />
            </g>
          </svg>
        </button>
        <button class="nav__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
          <i aria-hidden="true"></i><span>Menu</span>
        </button>
      </div>
    </div>
  </header>

  <div class="menu" id="menu" data-menu hidden>
    <nav class="wrap menu__links" aria-label="Mobile">
      {%- for key, href, label in nav_items %}
      <a class="menu__link" href="{{ root }}{{ href }}"{% if active == key %} aria-current="page"{% endif %}>{{ label }}</a>
      {%- endfor %}
    </nav>
    <div class="wrap menu__foot">
      <a href="mailto:{{ config.email }}">{{ config.email }}</a>
      <span data-clock>--:--</span>
    </div>
  </div>

  <main id="main">
    {% block content %}{% endblock %}
  </main>

  {% block footer %}
  <footer class="foot">
    <div class="wrap">
      <div class="foot__horizon">
        <div class="foot__rhythm" aria-label="Circadian cycle: lights on at ZT 00 and lights off at ZT 12">
          <span class="foot__phase foot__phase--start">ZT 00 · lights on</span>
          <span class="foot__phase foot__phase--mid">ZT 12 · lights off</span>
          <span class="foot__phase foot__phase--end">ZT 24</span>
          <i class="foot__marker" data-zt-marker aria-hidden="true"></i>
          <span class="sr-only" data-zt-label>Current local Zeitgeber time</span>
        </div>
      </div>

      <div class="foot__body">
        <div class="foot__about">
          <p class="foot__who">
            <strong>{{ config.name }}</strong>{% if config.name_native %} <span class="bn foot__native" lang="bn">{{ config.name_native }}</span>{% endif %}
          </p>
          <p class="foot__note">
            {{ (config.footer_note or ('Always happy to chat about circadian rhythms, sleep genetics, <em>Drosophila</em>, or R tools — write to' if is_owner else 'Questions or collaborations — write to')) | safe }}
            <a class="link" href="mailto:{{ config.email }}">{{ config.email }}</a>
            <button class="copy-chip" type="button" data-copy="{{ config.email }}"><span data-copy-label>copy</span></button>.
          </p>
          <p class="foot__tz">
            Currently in {{ config.location }} (<span data-tz-clock data-tz="{{ config.timezone }}">--:--</span> local<span data-tz-you>, <span data-clock-short>--:--</span> for you</span><span data-tz-same hidden>, same timezone as you</span>).
          </p>
        </div>

        <div class="foot__links">
          <a class="link" href="{{ config.scholar_url }}" target="_blank" rel="noopener">Google Scholar</a>
          <a class="link" href="https://github.com/{{ config.github }}" target="_blank" rel="noopener">GitHub</a>
          <a class="link" href="{{ root }}{{ config.cv_pdf }}" target="_blank" rel="noopener">CV (PDF)</a>
        </div>
      </div>

      <div class="foot__base">
        <span>© {{ config.copyright_year }} {{ config.name }} · Static HTML built from CSVs &amp; Python</span>
        <div class="foot__base-right">
          <button class="foot__term" type="button" data-term-open title="Open terminal shortcut"><span class="kbd">`</span> terminal</button>
          <button type="button" data-top>Top ↑</button>
        </div>
      </div>
    </div>
  </footer>
  {% endblock %}

  <script type="application/json" id="ag-data">{{ {
    'name': config.name,
    'native': config.name_native,
    'designation': config.designation,
    'affiliation': config.affiliation,
    'location': config.location,
    'email': config.email,
    'github': 'https://github.com/' ~ config.github,
    'scholar': config.scholar_url,
    'cv': root ~ config.cv_pdf,
    'bio': config.bio,
    'tags': config.tags,
    'root': root,
    'pages': nav_items | map('list') | list,
  } | tojson }}</script>
  <script src="{{ root }}assets/js/site.js" defer></script>
  {% block scripts %}{% endblock %}
  <script src="{{ root }}assets/js/terminal.js" defer></script>
</body>
</html>
