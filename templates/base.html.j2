{%- from '_macros.html.j2' import arrow, dial_mark -%}
{%- set nav_items = [
  ('index', 'index.html', 'About'),
  ('publications', 'publications.html', 'Publications'),
  ('repositories', 'repositories.html', 'Code'),
  ('cv', 'cv.html', 'CV'),
  ('teaching', 'teaching.html', 'Teaching'),
] -%}
{%- set city = config.location.split(',')[0] -%}
<!DOCTYPE html>
<html lang="en" data-theme="dark" data-page="{{ active }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% block title %}{{ config.name }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ config.name }}, {{ config.designation | lower }} at {{ config.affiliation }}, studying circadian rhythms and sleep genetics in Drosophila.{% endblock %}" />
  <meta name="author" content="{{ config.name }}" />
  <meta name="color-scheme" content="dark light" />
  <meta name="theme-color" content="#0a0c11" />
  <meta property="og:title" content="{{ self.title() }}" />
  <meta property="og:description" content="{{ self.description() }}" />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="{{ root }}favicon.svg" />
  {% block head_meta %}{% endblock %}
  <script>
    /* Runs before first paint: entrain the theme to the visitor's clock,
       flag JS-driven motion, and aim cross-page view transitions at the click. */
    (function () {
      var d = document.documentElement, h = new Date().getHours(), t = null, ss = null;
      try { t = localStorage.getItem('ag-theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') t = (h >= 6 && h < 18) ? 'light' : 'dark';
      d.setAttribute('data-theme', t);
      d.classList.add('js');
      try { ss = window.sessionStorage; } catch (e) {}
      var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var vt = 'PageRevealEvent' in window;
      if (ss) {
        {%- if active == 'index' %}
        if (!still && !ss.getItem('ag-entrained')) d.classList.add('intro');
        {%- endif %}
        try { ss.setItem('ag-entrained', '1'); } catch (e) {}
        if (!vt && !still && ss.getItem('ag-curtain')) d.classList.add('curtain-in');
        try { ss.removeItem('ag-curtain'); } catch (e) {}
      }
      addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        var p = null;
        try { p = JSON.parse(ss.getItem('ag-vt')); ss.removeItem('ag-vt'); } catch (_) {}
        if (p && Date.now() - p.t < 5000) {
          d.style.setProperty('--vt-x', p.x + 'px');
          d.style.setProperty('--vt-y', p.y + 'px');
        }
        e.viewTransition.finished.finally(function () {
          d.style.removeProperty('--vt-x');
          d.style.removeProperty('--vt-y');
        });
      });
      /* failsafe: if the motion script never arrives, show everything */
      setTimeout(function () {
        if (!d.classList.contains('ready')) d.classList.remove('js', 'intro', 'curtain-in');
      }, 4000);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,100..900,0..100,0..1;1,9..144,100..900,0..100,0..1&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400..600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tiro+Bangla&display=swap&text={{ config.name_native | urlencode }}" />
  <link rel="stylesheet" href="{{ root }}assets/css/site.css" />
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav" data-nav>
    <a class="nav__brand" href="{{ root }}index.html" aria-label="{{ config.name }}, home">
      {{ dial_mark() }}
      <span class="nav__name" data-roll>{{ config.name }}</span>
    </a>

    <nav class="nav__links" aria-label="Primary" data-navlinks>
      <span class="nav__hover" aria-hidden="true"></span>
      {%- for key, href, label in nav_items %}
      <a class="nav__link" href="{{ root }}{{ href }}"{% if active == key %} aria-current="page"{% endif %}>
        {%- if active == key %}<span class="nav__pill" aria-hidden="true"></span>{% endif -%}
        <span data-roll>{{ label }}</span>
      </a>
      {%- endfor %}
    </nav>

    <div class="nav__tools">
      <span class="nav__clock" data-clock title="Your local time, and Zeitgeber time (hours since 06:00, when the lights come on)">--:-- · <b>ZT --</b></span>
      <button class="ld" type="button" data-theme-toggle aria-label="Switch between light and dark">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <defs>
            <mask id="ld-mask" maskUnits="userSpaceOnUse" x="-6" y="-6" width="36" height="36">
              <rect x="-6" y="-6" width="36" height="36" fill="#fff" />
              <circle class="ld__cut" cx="17" cy="7" r="5.6" fill="#000" />
            </mask>
          </defs>
          <circle class="ld__core" cx="12" cy="12" r="4.6" mask="url(#ld-mask)" />
          <g class="ld__rays">
            <line x1="12" y1="1.6" x2="12" y2="4" /><line x1="12" y1="20" x2="12" y2="22.4" />
            <line x1="1.6" y1="12" x2="4" y2="12" /><line x1="20" y1="12" x2="22.4" y2="12" />
            <line x1="4.6" y1="4.6" x2="6.3" y2="6.3" /><line x1="17.7" y1="17.7" x2="19.4" y2="19.4" />
            <line x1="4.6" y1="19.4" x2="6.3" y2="17.7" /><line x1="17.7" y1="6.3" x2="19.4" y2="4.6" />
          </g>
        </svg>
      </button>
      <button class="nav__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <i aria-hidden="true"></i><span>Menu</span>
      </button>
    </div>
  </header>

  <div class="menu" id="menu" data-menu>
    <nav class="menu__links" aria-label="Mobile">
      {%- for key, href, label in nav_items %}
      <a class="menu__link" href="{{ root }}{{ href }}" style="--i:{{ loop.index0 }}"{% if active == key %} aria-current="page"{% endif %}><small>0{{ loop.index }}</small><span>{{ label }}</span></a>
      {%- endfor %}
    </nav>
    <div class="menu__foot">
      <span>{{ config.email }}</span>
      <span data-clock>--:--</span>
    </div>
  </div>

  <main id="main">
    {% block content %}{% endblock %}
  </main>

  {% block footer %}
  <footer class="foot">
    <div class="wrap">
      <div class="foot__cta">
        <p class="eyebrow" data-reveal="fade"><span class="idx">↘</span>Contact</p>
        <h2 class="foot__mail"><a href="mailto:{{ config.email }}" data-cursor-label="Write" data-words>Questions or collaborations? <em>Email me</em>.</a></h2>
        <div class="bio__links" data-reveal>
          <a class="btn btn--solid" href="mailto:{{ config.email }}" data-magnetic>{{ config.email }} <span class="btn__arrow">{{ arrow() }}</span></a>
          <button class="btn" type="button" data-copy="{{ config.email }}" data-magnetic><span data-copy-label>Copy address</span></button>
        </div>
      </div>

      <div class="foot__grid">
        <div class="foot__col" data-reveal style="--d:0">
          <p class="foot__h">Elsewhere</p>
          <a href="{{ config.scholar_url }}" target="_blank" rel="noopener"><span data-roll>Google Scholar</span></a>
          <a href="https://github.com/{{ config.github }}" target="_blank" rel="noopener"><span data-roll>GitHub</span></a>
          <a href="{{ root }}{{ config.cv_pdf }}" target="_blank" rel="noopener"><span data-roll>CV (PDF)</span></a>
        </div>
        <div class="foot__col" data-reveal style="--d:80">
          <p class="foot__h">Pages</p>
          {%- for key, href, label in nav_items %}
          <a href="{{ root }}{{ href }}"><span data-roll>{{ label }}</span></a>
          {%- endfor %}
        </div>
        <div class="foot__col" data-reveal style="--d:160">
          <p class="foot__h">Local time</p>
          <p class="foot__tz">It’s <b data-tz-clock data-tz="{{ config.timezone }}">--:--</b> in {{ city }}.<br /><span data-tz-you>For you, it’s <b data-clock-short>--:--</b>.</span><span data-tz-same hidden>Same as yours.</span></p>
        </div>
        <div class="foot__col" data-reveal style="--d:240">
          <p class="foot__h">Old habits</p>
          <button class="foot__key" type="button" data-term-open><span class="kbd">`</span> Open a terminal</button>
        </div>
      </div>
    </div>

    <p class="foot__word" aria-hidden="true" data-chars>{{ config.name }}</p>

    <div class="wrap foot__base">
      <span>© {{ config.copyright_year }} {{ config.name }}</span>
      <span>Built from CSV files and a circadian clock</span>
      <button type="button" data-top>Back to top ↑</button>
    </div>
  </footer>
  {% endblock %}

  <div class="curtain" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"><div class="cursor__ring"><span class="cursor__label"></span></div><div class="cursor__dot"></div></div>
  <div class="grain" aria-hidden="true"></div>

  <script type="application/json" id="ag-data">{{ {
    'name': config.name,
    'native': config.name_native,
    'designation': config.designation,
    'affiliation': config.affiliation,
    'location': config.location,
    'email': config.email,
    'github': 'https://github.com/' ~ config.github,
    'scholar': config.scholar_url,
    'cv': root ~ config.cv_pdf,
    'bio': config.bio,
    'tags': config.tags,
    'root': root,
    'pages': nav_items | map('list') | list,
  } | tojson }}</script>
  <script src="{{ root }}assets/js/site.js" defer></script>
  {% block scripts %}{% endblock %}
  <script src="{{ root }}assets/js/terminal.js" defer></script>
</body>
</html>
