{% extends 'base.html.j2' %}
{% from '_macros.html.j2' import arrow %}

{% block title %}404 — this page is arrhythmic{% endblock %}
{% block description %}Page not found.{% endblock %}
{% block head_meta %}<meta name="robots" content="noindex" />{% endblock %}

{% block content %}
  <section class="nf" aria-labelledby="nf-title">
    <canvas data-flies data-mode="arrhythmic" aria-hidden="true"></canvas>
    <div>
      <p class="nf__big" aria-hidden="true" data-chars>404</p>
      <h1 class="nf__title" id="nf-title" data-words>This page is <em>arrhythmic</em>.</h1>
      <p class="nf__text" data-reveal style="--d:300">Whatever lived at this address lost its rhythm, like a fly without a working <em>period</em> gene. Let’s get you re-entrained.</p>
      <p class="nf__path" data-reveal style="--d:400" data-nf-path></p>
      <div class="nf__links" data-reveal style="--d:500">
        <a class="btn btn--solid" href="{{ root }}index.html" data-magnetic>Back to the start <span class="btn__arrow">{{ arrow('right') }}</span></a>
        <a class="btn" href="{{ root }}publications.html" data-magnetic>Publications</a>
        <a class="btn" href="{{ root }}repositories.html" data-magnetic>Code</a>
      </div>
    </div>
  </section>
{% endblock %}

{% block footer %}{% endblock %}

{% block scripts %}
  <script src="{{ root }}assets/js/flies.js" defer></script>
{% endblock %}
