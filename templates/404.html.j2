{% extends 'base.html.j2' %}
{% from '_macros.html.j2' import arrow %}

{% block title %}404 — Page not found{% endblock %}
{% block description %}Page not found.{% endblock %}
{% block head_meta %}<meta name="robots" content="noindex" />{% endblock %}

{% block content %}
  <section class="nf" aria-labelledby="nf-title">
    <canvas data-flies data-mode="arrhythmic" aria-hidden="true"></canvas>
    <div class="nf__card">
      <p class="nf__code">404</p>
      <h1 class="nf__title" id="nf-title">This page is arrhythmic.</h1>
      <p class="nf__text">The page you’re looking for isn’t here. Try the homepage or publications.</p>
      <p class="nf__path" data-nf-path></p>
      <div class="nf__links">
        <a class="btn btn--solid" href="{{ root }}index.html">Back home {{ arrow('right') }}</a>
        <a class="btn" href="{{ root }}publications.html">Publications</a>
        <a class="btn" href="{{ root }}repositories.html">Code</a>
      </div>
    </div>
  </section>
{% endblock %}

{% block footer %}{% endblock %}

{% block scripts %}
  <script src="{{ root }}assets/js/flies.js" defer></script>
{% endblock %}
