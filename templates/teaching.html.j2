{% extends 'base.html.j2' %}

{% block title %}Teaching &amp; service — {{ config.name }}{% endblock %}
{% block description %}Teaching, mentoring, editorial and professional service by {{ config.name }}.{% endblock %}

{%- set labels = {
  'teaching': 'Teaching',
  'mentoring': 'Mentoring',
  'editorial': 'Editorial & peer review',
  'service': 'Academic & institute service',
} %}
{%- set order = ['teaching', 'mentoring', 'editorial', 'service'] %}
{%- set extra = service.keys() | reject('in', order) | list %}

{% block content %}
  <header class="phead wrap">
    <h1 class="phead__title">Teaching, mentoring &amp; service</h1>
    <p class="phead__lede">Courses and practical modules I have taught, students and trainees I have worked with in the lab, and editorial and committee service.</p>
  </header>

  <div class="wrap cv-wrap">
    {%- for key in order + extra %}
    {%- if service[key] %}
    {%- set heading = labels.get(key, key | title) %}
    <section class="cvsec" aria-labelledby="svc-{{ key }}">
      <h2 class="cvsec__label" id="svc-{{ key }}">{{ heading }}</h2>
      <ul class="svc__list">
        {%- for item in service[key] %}
        <li>{{ item.description | safe }}</li>
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}
    {%- endfor %}
  </div>
{% endblock %}
