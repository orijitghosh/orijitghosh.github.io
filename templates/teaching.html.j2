{% from 'base.html.j2' import topbar, statusbar %}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Teaching, mentoring, service, review, and outreach activities by {{ config.name }}." />
  <title>{{ config.name }} — Teaching / Service</title>
  <link rel="stylesheet" href="terminal.css" />
  <link rel="icon" type="image/svg+xml" href="favicon.svg" />
</head>
<body>
  {{ topbar('teaching') }}

  <div class="page-body">
    <div class="page-title fade-in"><span class="prompt">$</span> cat teaching.md</div>
    <div class="page-subtitle fade-in fade-in-d1"><span class="comment">// teaching, mentoring, and professional service</span></div>

    <div class="two-col">
      <div>
        {% if service.editorial %}
        <div class="fade-in fade-in-d2">
          <div class="section-label">// editorial &amp; review</div>
          {% for item in service.editorial %}
          <div class="service-item">{{ item.description | safe }}</div>
          {% endfor %}
        </div>
        {% endif %}

        {% if service.service %}
        <div class="fade-in fade-in-d3" style="margin-top: 28px;">
          <div class="section-label">// service at nih</div>
          {% for item in service.service %}
          <div class="service-item">{{ item.description | safe }}</div>
          {% endfor %}
        </div>
        {% endif %}

        {% if service.mentoring %}
        <div class="fade-in fade-in-d4" style="margin-top: 28px;">
          <div class="section-label">// mentoring</div>
          {% for item in service.mentoring %}
          <div class="service-item">{{ item.description | safe }}</div>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <div>
        {% if service.teaching %}
        <div class="fade-in fade-in-d3">
          <div class="section-label">// teaching</div>
          {% for item in service.teaching %}
          <div class="service-item">{{ item.description | safe }}</div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
  </div>

  {{ statusbar(config.status_bar.teaching, '© ' ~ config.copyright_year ~ ' ' ~ config.name) }}

  <script src="theme.js"></script>
  <script src="terminal-easteregg.js"></script>
</body>
</html>
