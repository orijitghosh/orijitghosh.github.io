{% extends 'base.html.j2' %}

{% block title %}Teaching &amp; service — {{ config.name }}{% endblock %}
{% block description %}Teaching, mentoring, editorial and professional service by {{ config.name }}.{% endblock %}

{%- set labels = {
  'teaching': ('Teaching', 'in the classroom'),
  'mentoring': ('Mentoring', 'trainees &amp; students'),
  'editorial': ('Editorial', '&amp; peer review'),
  'service': ('Service', 'at the NIH'),
} %}
{%- set order = ['teaching', 'mentoring', 'editorial', 'service'] %}
{%- set extra = service.keys() | reject('in', order) | list %}

{% block content %}
  <header class="phead wrap">
    <p class="eyebrow" data-reveal="fade"><span class="idx">{{ service.values() | map('length') | sum }}</span>Activities</p>
    <h1 class="phead__title" data-words>Teaching, mentoring<br /><em>&amp; service</em>.</h1>
    <div class="phead__row">
      <p class="phead__lede" data-reveal>Courses I’ve taught, students I’ve mentored, and editorial and committee work.</p>
    </div>
  </header>

  <div class="wrap">
    {%- for key in order + extra %}
    {%- if service[key] %}
    {%- set label = labels.get(key, (key | title, '')) %}
    <section class="svc" aria-labelledby="svc-{{ key }}">
      <div class="svc__side">
        <span class="svc__count" data-count="{{ service[key] | length }}" data-pad="2" aria-hidden="true">{{ '%02d' | format(service[key] | length) }}</span>
        <h2 class="svc__name" id="svc-{{ key }}" data-words>{{ label[0] }}{% if label[1] %} <em>{{ label[1] | safe }}</em>{% endif %}</h2>
      </div>
      <ol class="svc__list" data-stagger>
        {%- for item in service[key] %}
        <li data-reveal>{{ item.description | safe }}</li>
        {%- endfor %}
      </ol>
    </section>
    {%- endif %}
    {%- endfor %}
  </div>
{% endblock %}
